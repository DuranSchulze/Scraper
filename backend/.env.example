# Copy to the repository root as .env (cp backend/.env.example .env) and fill in. Never commit .env.

# Neon connection string (Neon dashboard -> Connection Details). Keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Required: random JWT signing secret, at least 32 characters.
JWT_SECRET=
# Creates the first admin at API startup only while the users table is empty.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=
# Optional public application URL; https forces Secure session cookies behind a proxy.
APP_URL=http://localhost:3000

# Service account JSON key with domain-wide delegation. Keep it OUTSIDE this repo.
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/outside/repo/sa-key.json
# Workspace admin the service account impersonates to list users.
GOOGLE_ADMIN_EMAIL=admin@company.com
GOOGLE_WORKSPACE_DOMAIN=company.com

# Comma list. Addresses on these domains are never treated as clients.
INTERNAL_DOMAINS=company.com
# Optional comma list of mailboxes to scrape. Empty = every user in the domain.
MAILBOXES=
# Optional comma list of Google Sheet IDs that are client trackers.
DRIVE_SHEET_IDS=
# Oldest date to scrape (YYYY-MM-DD).
SCRAPE_SINCE=2018-01-01
# Mailboxes fetched at once (1-8, default 4); each owns its DB connection.
SCRAPE_PARALLEL_MAILBOXES=4
# Message downloads per mailbox (1-25, default 16); lower if rate-limit retries are frequent.
SCRAPE_MESSAGE_WORKERS=16
# Empty/unset/non-integer values use the default; out-of-range integers are clamped.

# API bind address; use 0.0.0.0 on Render.
HOST=127.0.0.1
# PORT takes precedence over GUI_PORT; Render supplies PORT.
PORT=
GUI_PORT=8765
# Comma list of allowed API hosts (no scheme/port); include your Render hostname.
ALLOWED_HOSTS=127.0.0.1,localhost
# Exact browser origins, comma-separated. Empty disables CORS; never use *.
# Unneeded for the Next.js SCRAPER_API_URL rewrite.
CORS_ORIGINS=
# lax|none|strict (invalid values use lax); none always forces Secure (HTTPS).
COOKIE_SAMESITE=lax
